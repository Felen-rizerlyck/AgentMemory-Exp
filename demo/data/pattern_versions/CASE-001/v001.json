{
  "schema_version": "demo-1.0",
  "case_id": "CASE-001",
  "pattern_type": "attack_behavior_pattern",
  "name": "Log4Shell JNDI 注入（LDAP 回连 + Base64 命令执行）",
  "summary": "Web 参数注入 ${jndi:ldap://…} → 应用侧 JNDI 解析并回连攻击者 LDAP → 主机侧 java 进程派生子 shell 执行命令。",
  "pattern_scope": {
    "attack_family": "Log4j2 JNDI 注入（CVE-2021-44228）",
    "variant_note": "由单个合成样本归纳；RMI/DNS 协议变体与二次载荷形式尚未多实例验证。"
  },
  "mitre": [
    "T1190",
    "T1059.004",
    "T1105"
  ],
  "steps": [
    {
      "step_id": "S1",
      "order": 1,
      "phase": "initial_access",
      "action_id": "log4shell_jndi_param",
      "label": "Web 参数中的 ${jndi:…} 注入",
      "action_regex": "(?i)\\$\\{jndi:(?:ldap|rmi|dns|iiop)://",
      "expected_sources": [
        "waf",
        "web"
      ],
      "evidence_patterns": [
        "${jndi:ldap://"
      ],
      "generic": false
    },
    {
      "step_id": "S2",
      "order": 2,
      "phase": "execution",
      "action_id": "log4shell_app_jndi_lookup",
      "label": "应用侧 JNDI 解析并回连",
      "action_regex": "(?i)\\\"jndi\\\"\\s*:\\s*\\\"(?:ldap|rmi|dns)://",
      "expected_sources": [
        "rasp"
      ],
      "evidence_patterns": [
        "{\"jndi\": \"ldap://"
      ],
      "generic": true
    },
    {
      "step_id": "S3",
      "order": 3,
      "phase": "execution",
      "action_id": "log4shell_java_child_cmd",
      "label": "java 进程派生子 shell 执行命令",
      "action_regex": "(?i)/bin/(?:sh|bash)\\s+-c\\s+'[^']{1,40}'.{0,80}java(?:\\.exe)?\\s+-jar",
      "expected_sources": [
        "hids"
      ],
      "evidence_patterns": [
        "<== /usr/bin/java -jar"
      ],
      "generic": true
    }
  ],
  "retrieval": {
    "keywords": [
      "jndi:ldap",
      "auth-service.jar",
      "uname -a",
      "base64"
    ],
    "pattern_probes": [
      "\\$\\{jndi:ldap://",
      "\\\"jndi\\\"\\s*:\\s*\\\"ldap://",
      "java(?:\\.exe)?\\s+-jar\\s+/opt/app/"
    ]
  },
  "negative_and_unknown_evidence": {
    "not_observed": [
      "横向移动",
      "凭据窃取",
      "反序列化回显"
    ],
    "interpretation": "未观察到不等同于确认不存在；需结合日志覆盖范围判断。"
  },
  "provenance": {
    "evidence_status": "single_observation_demo"
  },
  "family_id": "web-exploit",
  "version": 1
}

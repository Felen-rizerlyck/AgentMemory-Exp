{
  "case_id": "CASE-009",
  "name": "Spring4Shell 属性链写入与容器命令执行",
  "summary": "Spring4Shell/CVE-2022-22965：通过 class.module.classLoader 属性链改写 Tomcat 日志配置写入 JSP，随后由 catalina.sh 派生 whoami 验证执行。",
  "mitre": [
    "T1190",
    "T1059.004"
  ],
  "retrieval": {
    "keywords": [
      "class.module.classLoader",
      "pipeline.first",
      "classLoader.first",
      "catalina.sh"
    ],
    "pattern_probes": [
      "class\\.module\\.classLoader",
      "pipeline\\.first",
      "classLoader\\.first"
    ]
  },
  "steps": [
    {
      "step_id": "S1",
      "order": 1,
      "action_id": "spring4shell_classloader_probe",
      "label": "class.module.classLoader 属性链探测（WAF/Web）",
      "action_regex": "(?i)class\\.module\\.classLoader|pipeline\\.first\\.pattern",
      "expected_sources": [
        "waf",
        "web"
      ],
      "generic": false,
      "required": true
    },
    {
      "step_id": "S2",
      "order": 2,
      "action_id": "spring4shell_rasp_property",
      "label": "RASP 观察到 classLoader.first 属性访问",
      "action_regex": "(?i)classLoader\\.first|class\\.module\\.classLoader",
      "expected_sources": [
        "rasp"
      ],
      "generic": false,
      "required": true
    },
    {
      "step_id": "S3",
      "order": 3,
      "action_id": "spring4shell_container_exec",
      "label": "Tomcat catalina.sh 派生 whoami 执行",
      "action_regex": "(?i)(?:catalina\\.sh.*whoami|whoami.*catalina\\.sh)",
      "expected_sources": [
        "hids"
      ],
      "generic": false,
      "required": true
    }
  ],
  "pattern_scope": {
    "variant_note": "单样本晋升：只覆盖探测→属性访问→容器命令执行；未观察到内存马落地或横向。"
  },
  "negative_and_unknown_evidence": {
    "not_observed": [
      "JSP webshell 落地文件",
      "横向移动",
      "持久化"
    ],
    "interpretation": "单样本模式；required 骨架是本次观测到的三步，不代表所有 Spring4Shell 利用都具备同样顺序。"
  },
  "provenance": {
    "evidence_status": "single_observation"
  },
  "version": 1,
  "family_id": "web-exploit",
  "admission_id": "ADM-CASE-009"
}

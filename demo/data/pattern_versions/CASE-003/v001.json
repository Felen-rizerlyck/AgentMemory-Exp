{
  "schema_version": "demo-1.0",
  "case_id": "CASE-003",
  "pattern_type": "attack_behavior_pattern",
  "name": "Windows 计划任务持久化（schtasks 周期拉起载荷）",
  "summary": "调度接口被注入 schtasks 命令 → 应用侧记录 cmd_inject=schtasks → 主机侧创建周期计划任务执行 C:\\Windows\\Temp 下的载荷。",
  "pattern_scope": {
    "attack_family": "Windows 计划任务持久化",
    "variant_note": "由单个合成样本归纳；任务名/触发间隔/载荷路径均来自该样本，未验证其它调度器变体。"
  },
  "mitre": [
    "T1053.005",
    "T1059.003"
  ],
  "steps": [
    {
      "step_id": "S1",
      "order": 1,
      "phase": "initial_access",
      "action_id": "scheduler_cmd_inject",
      "label": "调度接口命令注入（cmd=schtasks）",
      "action_regex": "(?i)cmd=schtasks\\s+/create",
      "expected_sources": [
        "waf"
      ],
      "evidence_patterns": [
        "cmd=schtasks /create"
      ],
      "generic": false
    },
    {
      "step_id": "S2",
      "order": 2,
      "phase": "execution",
      "action_id": "scheduler_cmd_inject_rasp",
      "label": "应用侧记录 cmd_inject=schtasks",
      "action_regex": "(?i)\\\"cmd_inject\\\"\\s*:\\s*\\\"schtasks",
      "expected_sources": [
        "rasp"
      ],
      "evidence_patterns": [
        "{\"cmd_inject\": \"schtasks"
      ],
      "generic": false
    },
    {
      "step_id": "S3",
      "order": 3,
      "phase": "persistence",
      "action_id": "schtasks_interval_task",
      "label": "创建周期计划任务执行载荷",
      "action_regex": "(?i)schtasks(?:\\.exe)?\\s+/create.{0,60}/sc\\s+minute",
      "expected_sources": [
        "hids"
      ],
      "evidence_patterns": [
        "/sc minute"
      ],
      "generic": false
    }
  ],
  "retrieval": {
    "keywords": [
      "schtasks /create",
      "/api/v1/scheduler/run",
      "cmd_inject"
    ],
    "pattern_probes": [
      "schtasks\\s+/create",
      "\\\"cmd_inject\\\"\\s*:\\s*\\\"schtasks",
      "/api/v1/scheduler/run"
    ]
  },
  "negative_and_unknown_evidence": {
    "not_observed": [
      "横向移动",
      "凭据窃取",
      "载荷内容"
    ],
    "interpretation": "未观察到不等同于确认不存在；需结合日志覆盖范围判断。"
  },
  "provenance": {
    "evidence_status": "single_observation_demo"
  },
  "family_id": "host-persistence",
  "version": 1
}

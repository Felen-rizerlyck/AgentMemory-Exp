    {
      "step_id": "S2",
      "order": 2,
      "phase": "impact",
      "action_id": "cipher_efs_batch_encrypt",
      "label": "cipher 批量加密目录",
      "action_regex": "(?i)(?:^|\\s)cipher(?:\\.exe)?\\s+/e\\s+/s:",
      "expected_sources": [
        "hids"
      ],
      "evidence_patterns": [
        "cipher /e /s:"
      ],
      "generic": false
    },
    {
      "step_id": "S3",
      "order": 3,
      "phase": "impact",
      "action_id": "vssadmin_delete_shadows_all",
      "label": "删除全部卷影副本",
      "action_regex": "(?i)vssadmin(?:\\.exe)?\\s+delete\\s+shadows\\s+/all",
      "expected_sources": [
        "hids"
      ],
      "evidence_patterns": [

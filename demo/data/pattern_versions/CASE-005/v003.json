      "order": 1,
      "phase": "persistence",
      "action_id": "webshell_upload_action",
      "label": "上传接口落地 WebShell",
      "action_regex": "(?i)wp-admin/admin-ajax\\.php\\?action=upload|\\\"upload\\\"\\s*:\\s*\\\"[a-z0-9_.-]{1,40}\\.php\\\"",
      "expected_sources": [
